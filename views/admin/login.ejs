<%- include('../partials/header') %>

<section class="px-6 py-12 flex-grow flex flex-col justify-center">
  <div class="space-y-6 bg-white/70 border border-rose-100/40 rounded-[2rem] p-6 shadow-sm">
    
    <div class="text-center space-y-2">
      <h2 class="serif-title text-2xl font-bold text-stone-900">Admin Inloggen</h2>
      <p class="text-xs text-stone-500 font-light">Beveiligde toegang tot Lisa's dashboard</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-600 text-xs px-4 py-3 rounded-2xl">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div class="space-y-1">
        <label for="password" class="text-xs font-mono font-bold uppercase tracking-wider text-stone-500">Wachtwoord</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Voer het admin wachtwoord in" 
          required 
          class="w-full bg-stone-50/50 border border-stone-200 rounded-2xl px-4 py-3.5 text-sm text-stone-850 placeholder-stone-400 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition"
        >
      </div>

      <button 
        type="submit" 
        class="w-full bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-2xl py-4 text-sm tracking-wide transition active:scale-[0.98] shadow-lg shadow-rose-500/10"
      >
        Inloggen
      </button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
