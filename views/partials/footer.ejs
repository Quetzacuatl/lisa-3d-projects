  </main>

  <!-- Footer -->
  <footer class="border-t border-rose-100/40 bg-white/40 py-8 px-6 mt-auto">
    <div class="max-w-md mx-auto text-center space-y-6">
      
      <!-- Nieuwsbrief Inschrijving -->
      <div class="bg-white/80 border border-rose-100/60 rounded-[2rem] p-6 text-left space-y-4 shadow-sm">
        <h3 class="serif-title text-xl font-semibold text-stone-900">Blijf op de hoogte</h3>
        <p class="text-xs text-stone-500 leading-relaxed font-light">
          Schrijf je in voor de nieuwsbrief en ontvang een bericht zodra Lisa nieuwe, unieke prints online zet!
        </p>
        <form action="/subscribe" method="POST" class="flex flex-col space-y-2">
          <input 
            type="email" 
            name="email" 
            placeholder="Je e-mailadres" 
            required 
            class="w-full bg-stone-50/50 border border-stone-200 rounded-2xl px-4 py-3.5 text-sm text-stone-850 placeholder-stone-400 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition"
          >
          <button 
            type="submit" 
            class="w-full bg-rose-500 hover:bg-rose-600 active:scale-[0.98] text-white font-bold rounded-2xl py-3.5 text-sm tracking-wide transition shadow-lg shadow-rose-500/10"
          >
            Abonneren
          </button>
        </form>
      </div>

      <!-- Footer Info -->
      <div class="flex flex-col items-center justify-center space-y-2 text-stone-400 text-xs">
        <p>© 2026 Lisa. 3D Studio. Alle rechten voorbehouden.</p>
        <p class="font-mono text-[9px] uppercase tracking-wider text-rose-500 font-bold flex items-center space-x-1">
          <span>Handgemaakt met</span>
          <svg class="w-3 h-3 fill-rose-500 animate-pulse" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </p>
      </div>

    </div>
  </footer>

  <!-- Toon succes/foutmelding na aanmelden -->
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('subscribed') === 'true') {
      alert('Super! Je bent met succes ingeschreven voor updates.');
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    } else if (urlParams.get('subscribed') === 'false') {
      alert('Er ging iets mis bij het inschrijven. Probeer het nog een keer.');
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }
  </script>
</body>
</html>
