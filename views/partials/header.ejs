<!DOCTYPE html>
<html lang="nl" class="h-full bg-stone-950 text-stone-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lisa. 3D Studio</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              gold: '#D4AF37',
              primary: '#1c1917',
              accent: '#f59e0b',
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
          }
        }
      }
    }
  </script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .serif-title {
      font-family: 'Playfair Display', serif;
    }
    /* Verberg scrollbars maar behoud scroll functionaliteit */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="h-full flex flex-col bg-stone-950 text-stone-200 antialiased overflow-x-hidden selection:bg-amber-500/20 selection:text-amber-300">
  
  <!-- Header / Navigatie (Geoptimaliseerd voor mobiel) -->
  <header class="border-b border-stone-900 bg-stone-950/85 backdrop-blur-lg sticky top-0 z-40">
    <div class="max-w-md mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center space-x-2">
        <span class="serif-title text-2xl font-bold tracking-tight text-stone-100">Lisa<span class="text-amber-500">.</span></span>
        <span class="text-[9px] uppercase tracking-widest bg-stone-900 text-stone-400 px-2 py-0.5 rounded font-mono font-bold">3D Studio</span>
      </a>
      
      <a href="/admin" class="text-xs text-stone-400 hover:text-stone-100 font-mono tracking-widest uppercase transition bg-stone-900 hover:bg-stone-850 px-3 py-1.5 rounded-full border border-stone-800">
        Admin
      </a>
    </div>
  </header>

  <!-- Hoofdcontainer: Altijd mobiele breedte, gecentreerd op grote schermen -->
  <main class="flex-grow max-w-md w-full mx-auto pb-12 flex flex-col">
